{
  "name": "frontend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test": "${RUN_TESTS:-} vitest run --dir src --maxWorkers=4",
    "test:related": "${RUN_TESTS:-} vitest related --run --dir src --maxWorkers=4",
    "test:unit": "vitest",
    "test:cash-live:unit": "vitest run -c e2e/cash-live/vitest.config.ts",
    "test:editorial-live:unit": "vitest run -c e2e/editorial-live/vitest.config.ts",
    "test:responsive:harness": "${RUN_TESTS:-} playwright test --config=playwright.responsive.config.ts --grep @responsive-harness",
    "test:responsive:promotion-capacity": "${RUN_TESTS:-} playwright test --config=playwright.responsive.config.ts e2e/responsive/specs/promotion-capacity.spec.ts e2e/responsive/specs/promotion-capacity-requote.spec.ts e2e/responsive/specs/sale-cancellation.spec.ts e2e/responsive/specs/promotion-alerts.spec.ts",
    "test:responsive:conformance": "${RUN_TESTS:-} playwright test --config=playwright.responsive.config.ts e2e/responsive/specs/dt01-products.spec.ts e2e/responsive/specs/hy04-notifications.spec.ts",
    "test:responsive:headed": "${RUN_TESTS:-} playwright test --headed --config=playwright.responsive.config.ts e2e/responsive/specs/dt01-products.spec.ts e2e/responsive/specs/hy04-notifications.spec.ts",
    "type-check:responsive": "tsc --noEmit -p tsconfig.responsive.json",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "run-s lint:*",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "format": "prettier --write --experimental-cli src/"
  },
  "dependencies": {
    "@casl/ability": "^6.8.0",
    "@casl/vue": "^2.2.6",
    "@iconify/vue": "5.0.0",
    "@internationalized/date": "^3.12.1",
    "@nuxt/ui": "^4.6.0",
    "@tanstack/vue-query": "^5.95.2",
    "@tanstack/vue-table": "^8.21.3",
    "@unovis/ts": "^1.7.0",
    "@unovis/vue": "^1.7.0",
    "@vueuse/core": "^14.2.1",
    "axios": "^1.14.0",
    "date-fns": "^4.1.0",
    "jwt-decode": "^4.0.0",
    "leaflet": "^1.9.4",
    "pinia": "^3.0.4",
    "vue": "^3.5.29",
    "vue-router": "^5.0.3",
    "vuedraggable": "^4.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@fontsource/geist": "^5.3.0",
    "@iconify-json/lucide": "^1.2.156",
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "^4.2.2",
    "@tsconfig/node24": "^24.0.4",
    "@types/jsdom": "^28.0.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^24.11.0",
    "@vitejs/plugin-vue": "^6.0.4",
    "@vitest/eslint-plugin": "^1.6.9",
    "@vue/eslint-config-typescript": "^14.7.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.8.1",
    "eslint": "^10.0.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "~1.50.0",
    "eslint-plugin-vue": "~10.8.0",
    "jiti": "^2.6.1",
    "jsdom": "^28.1.0",
    "npm-run-all2": "^8.0.4",
    "oxlint": "~1.50.0",
    "prettier": "3.8.1",
    "tailwindcss": "^4.2.2",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-vue-devtools": "^8.0.6",
    "vitest": "^4.0.18",
    "vue-tsc": "^3.2.5"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
